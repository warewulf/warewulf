{{- /*
This template renders /etc/hosts for both the Warewulf server and the nodes,
selected by .HostOverlay: true when this overlay is being built for the server
itself, false when it is built for a node.

On the server the file already exists and may carry entries an administrator
added by hand, so everything above the marker line is preserved and only the
block below it is regenerated. A node's file is generated from scratch, and
so needs the loopback entries that the server's file already has.
*/ -}}
{{- if .HostOverlay -}}
{{ IncludeBlock "/etc/hosts" "# Do not edit after this line" }}
# This block is autogenerated by warewulf
{{ else -}}
127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4
::1         localhost localhost.localdomain localhost6 localhost6.localdomain6
{{ end }}
# Warewulf Server
{{$.Ipaddr}} {{$.BuildHost}} warewulf

{{- range $node := $.AllNodes}}{{/* for each node */}}
# Entry for {{$node.Id}}
{{- if $node.Ipmi.Ipaddr}}{{/* if we have a BMC address on the node */}}
{{$node.Ipmi.Ipaddr}} {{$node.Id}}-ipmi
{{- end }}
{{- range $devname, $netdev := $node.NetDevs}}{{/* for each network device on the node */}}
{{- if $netdev.Ipaddr}}{{/* if we have an ip address on this network device */}}
{{- /* emit the node name as hostname if this is the primary */}}
{{$netdev.Ipaddr}} {{if $netdev.Primary}}{{$node.Id}}{{end}} {{$node.Id}}-{{$devname}} {{if $netdev.Device}}{{$node.Id}}-{{$netdev.Device}}{{end}}
{{- end }}{{/* if ip */}}
{{- end }}{{/* for each network device */}}
{{- end }}{{/* for each node */}}

{{- if .Ipv6 }}

# Warewulf Ipv6
{{$.Ipaddr6}} {{$.BuildHost}} warewulf

{{- range $node := $.AllNodes}}{{/* for each node */}}
# Entry for {{$node.Id}}
{{- range $devname, $netdev := $node.NetDevs}}{{/* for each network device on the node */}}
{{- if $netdev.Ipaddr6}}{{/* if we have an ip address on this network device */}}
{{- /* emit the node name as hostname if this is the primary */}}
{{$netdev.Ipaddr6}} {{if $netdev.Primary}}{{$node.Id}}{{end}} {{$node.Id}}-{{$devname}} {{if $netdev.Device}}{{$node.Id}}-{{$netdev.Device}}{{end}}
{{- end }}{{/* if ip */}}
{{- end }}{{/* for each network device */}}
{{- end }}{{/* for each node */}}

{{- end }}{{/* for .IPv6 */}}
